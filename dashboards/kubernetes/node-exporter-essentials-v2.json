{
  "annotations": {"list": []},
  "description": "node-exporter essentials v2. 32 panels covering CPU (incl. mode breakdown + iowait), memory (incl. swap), disk I/O (throughput, IOPS, utilization), filesystems (incl. inodes), network (incl. errors and drops), sockets+conntrack, PSI pressure metrics, and system health (incl. OOM kills, clock skew). Adds dimensions v1 lacked. Perses-compatible.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true,
      "title": "Runbook: node-exporter",
      "tooltip": "Runbook in rtifact-alert-rules",
      "type": "link",
      "url": "https://github.com/cipherops-io/rtifact-alert-rules/blob/main/runbooks/kubernetes/node-exporter.yaml"
    }
  ],
  "liveNow": false,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": [], "title": "Cluster snapshot", "type": "row"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Active nodes reporting node-exporter metrics.", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 3}]}, "unit": "none"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 0, "y": 1}, "id": 1, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(node_uname_info{cluster=~\"$cluster\",instance=~\"$instance\"})", "instant": true, "legendFormat": "Active", "refId": "A"}], "title": "Active nodes", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Sum of CPU cores across all nodes.", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "none"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 3, "y": 1}, "id": 2, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(count without (cpu, mode) (node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}))", "instant": true, "legendFormat": "Cores", "refId": "A"}], "title": "Total CPU cores", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Sum of physical memory across all nodes.", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "bytes"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 6, "y": 1}, "id": 3, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"})", "instant": true, "legendFormat": "Total", "refId": "A"}], "title": "Total memory", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Cluster CPU utilisation (non-idle).", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 9, "y": 1}, "id": 4, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "1 - avg(rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}[5m]))", "instant": true, "legendFormat": "Used", "refId": "A"}], "title": "Cluster CPU %", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Number of nodes with CPU > 85%.", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 12, "y": 1}, "id": 5, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count((1 - avg by (instance) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}[5m]))) > 0.85) OR vector(0)", "instant": true, "legendFormat": "High CPU", "refId": "A"}], "title": "Nodes CPU > 85%", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Number of nodes with memory > 90%.", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 15, "y": 1}, "id": 6, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count((1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}) > 0.9) OR vector(0)", "instant": true, "legendFormat": "High mem", "refId": "A"}], "title": "Nodes memory > 90%", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Filesystems > 85% full (excludes tmpfs/overlay/squashfs).", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}, "unit": "none"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 18, "y": 1}, "id": 7, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count((1 - node_filesystem_avail_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|fuse.lxcfs|squashfs|overlay|nsfs\"} / node_filesystem_size_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|fuse.lxcfs|squashfs|overlay|nsfs\"}) > 0.85) OR vector(0)", "instant": true, "legendFormat": "FS full", "refId": "A"}], "title": "Filesystems > 85% full", "type": "stat"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Nodes whose 5m load > 2x core count.", "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []}, "gridPos": {"h": 4, "w": 3, "x": 21, "y": 1}, "id": 8, "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}, "pluginVersion": "10.4.0", "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count((node_load5{cluster=~\"$cluster\",instance=~\"$instance\"} / count without (cpu, mode) (node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"})) > 2) OR vector(0)", "instant": true, "legendFormat": "High load", "refId": "A"}], "title": "Nodes load > 2x cores", "type": "stat"},

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": [], "title": "CPU", "type": "row"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 nodes by CPU utilisation (5m avg, non-idle).", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6}, "id": 9, "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, 1 - avg by (instance) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}], "title": "Top 10 nodes by CPU %", "type": "timeseries"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Cluster-wide CPU breakdown by mode (cores spent in each mode per second). Stacked.", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "short"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6}, "id": 10, "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (mode) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode!=\"idle\"}[5m]))", "legendFormat": "{{mode}}", "refId": "A"}], "title": "Cluster CPU usage by mode", "type": "timeseries"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 nodes by CPU iowait. Sustained > 5% indicates disk I/O bottleneck.", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.15}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6}, "id": 11, "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, avg by (instance) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"iowait\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}], "title": "Top 10 nodes by CPU iowait", "type": "timeseries"},

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "id": 102, "panels": [], "title": "Memory", "type": "row"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 nodes by memory utilisation (1 - available/total).", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 15}, "id": 12, "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, 1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"})", "legendFormat": "{{instance}}", "refId": "A"}], "title": "Top 10 nodes by memory %", "type": "timeseries"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Cluster memory breakdown: used / cached / buffers / free. Sums to total.", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "bytes"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 15}, "id": 13, "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [
      {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum(node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} - node_memory_MemFree_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} - node_memory_Buffers_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} - node_memory_Cached_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}), \"kind\", \"used\", \"\", \"\")", "legendFormat": "{{kind}}", "refId": "A"},
      {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum(node_memory_Buffers_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}), \"kind\", \"buffers\", \"\", \"\")", "legendFormat": "{{kind}}", "refId": "B"},
      {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum(node_memory_Cached_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}), \"kind\", \"cached\", \"\", \"\")", "legendFormat": "{{kind}}", "refId": "C"},
      {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum(node_memory_MemFree_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}), \"kind\", \"free\", \"\", \"\")", "legendFormat": "{{kind}}", "refId": "D"}
    ], "title": "Cluster memory breakdown", "type": "timeseries"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 nodes by swap utilisation. Filters out nodes without swap configured.", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 0.9}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 15}, "id": 14, "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, 1 - node_memory_SwapFree_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} / (node_memory_SwapTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} != 0))", "legendFormat": "{{instance}}", "refId": "A"}], "title": "Top 10 nodes by swap %", "type": "timeseries"},

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "id": 103, "panels": [], "title": "Disk I/O", "type": "row"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 nodes by total disk read+write throughput.", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "Bps"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}, "id": 15, "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (instance) (rate(node_disk_read_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]) + rate(node_disk_written_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}], "title": "Top 10 nodes by disk throughput (r+w)", "type": "timeseries"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 disks by IOPS (reads + writes per second).", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "iops"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}, "id": 16, "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (instance, device) (rate(node_disk_reads_completed_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]) + rate(node_disk_writes_completed_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "legendFormat": "{{instance}}/{{device}}", "refId": "A"}], "title": "Top 10 disks by IOPS", "type": "timeseries"},

    {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "description": "Top 10 disks by % time spent doing I/O. > 80% sustained = disk saturated.", "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 0.8}]}, "unit": "percentunit"}, "overrides": []}, "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}, "id": 17, "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (instance, device) (rate(node_disk_io_time_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "legendFormat": "{{instance}}/{{device}}", "refId": "A"}], "title": "Top 10 disks by % I/O utilisation", "type": "timeseries"},

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 104, "panels": [], "title": "Filesystems", "type": "row"},

