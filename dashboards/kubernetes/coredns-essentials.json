{
  "annotations": {"list": []},
  "description": "Production CoreDNS dashboard. Query traffic, response codes, latency, cache, forward health, panics. Perses-compatible (stat + timeseries only, no overrides/transformations).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true,
      "title": "Runbook: coredns",
      "tooltip": "Runbook in rtifact-alert-rules",
      "type": "link",
      "url": "https://github.com/cipherops-io/rtifact-alert-rules/blob/main/runbooks/kubernetes/coredns.yaml"
    }
  ],
  "liveNow": false,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": [], "title": "Cluster snapshot", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of CoreDNS instances reporting metrics.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}, "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(coredns_build_info{cluster=~\"$cluster\",instance=~\"$instance\"})", "instant": true, "legendFormat": "Instances", "refId": "A"}],
      "title": "Active CoreDNS", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Total DNS queries per second (cluster-wide).",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(coredns_dns_requests_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))", "instant": true, "legendFormat": "QPS", "refId": "A"}],
      "title": "Total QPS", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Cache hit ratio. Healthy clusters typically have > 70%.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.7}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(coredns_cache_hits_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])) / (sum(rate(coredns_cache_hits_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])) + sum(rate(coredns_cache_misses_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "instant": true, "legendFormat": "Hit ratio", "refId": "A"}],
      "title": "Cache hit ratio", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "p99 DNS request duration (cluster-wide). Healthy clusters < 50ms.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.5}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "histogram_quantile(0.99, sum by (le) (rate(coredns_dns_request_duration_seconds_bucket{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "instant": true, "legendFormat": "p99", "refId": "A"}],
      "title": "DNS p99 latency", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Rate of error responses (SERVFAIL / REFUSED / FORMERR / NOTIMP).",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1}, "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(coredns_dns_responses_total{cluster=~\"$cluster\",instance=~\"$instance\",rcode=~\"SERVFAIL|REFUSED|FORMERR|NOTIMP\"}[5m])) OR vector(0)", "instant": true, "legendFormat": "Errors", "refId": "A"}],
      "title": "Error responses /s", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of CoreDNS panics in the last 1 hour. Should be 0.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1}, "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(increase(coredns_panics_total{cluster=~\"$cluster\",instance=~\"$instance\"}[1h])) OR vector(0)", "instant": true, "legendFormat": "Panics 1h", "refId": "A"}],
      "title": "Panics (1h)", "type": "stat"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": [], "title": "Query traffic", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 zones by query rate.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 7,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (zone) (rate(coredns_dns_requests_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "legendFormat": "{{zone}}", "refId": "A"}],
      "title": "Top 10 zones by QPS", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Query rate broken down by record type (A, AAAA, PTR, SRV, etc.).",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 8,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (type) (rate(coredns_dns_requests_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{type}}", "refId": "A"}],
      "title": "Query rate by record type", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Query rate per CoreDNS instance — shows load distribution.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "id": 9,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (instance) (rate(coredns_dns_requests_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Query rate per instance", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Query rate by family (1 = IPv4, 2 = IPv6).",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "id": 10,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (family) (rate(coredns_dns_requests_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))", "legendFormat": "family {{family}}", "refId": "A"}],
      "title": "Query rate by family (IPv4/IPv6)", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "id": 102, "panels": [], "title": "Responses & errors", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Response rate stacked by rcode. NOERROR is normal; SERVFAIL/REFUSED/FORMERR/NOTIMP are errors.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 23}, "id": 11,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (rcode) (rate(coredns_dns_responses_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))", "legendFormat": "{{rcode}}", "refId": "A"}],
      "title": "Response rate by rcode", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 zones by SERVFAIL rate. Sustained SERVFAIL = upstream DNS broken or zone misconfigured.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 2, "showPoints": "auto", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 23}, "id": 12,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (zone) (rate(coredns_dns_responses_total{cluster=~\"$cluster\",instance=~\"$instance\",rcode=\"SERVFAIL\"}[5m])))", "legendFormat": "{{zone}}", "refId": "A"}],
      "title": "Top 10 zones by SERVFAIL rate", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 instances by error response rate.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 2, "showPoints": "auto", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 23}, "id": 13,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (instance) (rate(coredns_dns_responses_total{cluster=~\"$cluster\",instance=~\"$instance\",rcode=~\"SERVFAIL|REFUSED|FORMERR|NOTIMP\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Top 10 instances by error rate", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}, "id": 103, "panels": [], "title": "Latency", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "DNS request duration percentiles (cluster-wide).",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.5}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32}, "id": 14,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(histogram_quantile(0.5, sum by (le) (rate(coredns_dns_request_duration_seconds_bucket{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))), \"quantile\", \"p50\", \"\", \"\")", "legendFormat": "{{quantile}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(histogram_quantile(0.95, sum by (le) (rate(coredns_dns_request_duration_seconds_bucket{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))), \"quantile\", \"p95\", \"\", \"\")", "legendFormat": "{{quantile}}", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(histogram_quantile(0.99, sum by (le) (rate(coredns_dns_request_duration_seconds_bucket{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))), \"quantile\", \"p99\", \"\", \"\")", "legendFormat": "{{quantile}}", "refId": "C"}
      ],
      "title": "DNS request duration (p50/p95/p99)", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 zones by p99 request duration.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32}, "id": 15,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, histogram_quantile(0.99, sum by (le, zone) (rate(coredns_dns_request_duration_seconds_bucket{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))))", "legendFormat": "{{zone}}", "refId": "A"}],
      "title": "Top 10 zones by p99 latency", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 instances by p99 request duration.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32}, "id": 16,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, histogram_quantile(0.99, sum by (le, instance) (rate(coredns_dns_request_duration_seconds_bucket{cluster=~\"$cluster\",instance=~\"$instance\"}[5m]))))", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Top 10 instances by p99 latency", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40}, "id": 104, "panels": [], "title": "Cache", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Cache hits vs misses rate. A high miss rate hammers upstream resolvers.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 41}, "id": 17,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum(rate(coredns_cache_hits_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])), \"result\", \"hits\", \"\", \"\")", "legendFormat": "{{result}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum(rate(coredns_cache_misses_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])), \"result\", \"misses\", \"\", \"\")", "legendFormat": "{{result}}", "refId": "B"}
      ],
      "title": "Cache hits vs misses", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Cache hit ratio over time.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.7}]}, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 41}, "id": 18,
      "options": {"legend": {"calcs": ["max", "mean", "min"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(rate(coredns_cache_hits_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])) / (sum(rate(coredns_cache_hits_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])) + sum(rate(coredns_cache_misses_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))", "legendFormat": "Hit ratio", "refId": "A"}],
      "title": "Cache hit ratio (over time)", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Cache entries per instance. Sudden drops = pod restart (cold cache).",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 49}, "id": 19,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (instance) (coredns_cache_entries{cluster=~\"$cluster\",instance=~\"$instance\"})", "legendFormat": "{{instance}}", "refId": "A"}],
      "title": "Cache size (entries) per instance", "type": "timeseries"
    },

