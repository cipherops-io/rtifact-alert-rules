{
  "annotations": {"list": []},
  "description": "kube-state-metrics essentials v2. 25 panels covering cluster health, workload rollouts, node pressure, storage, namespace resource usage, autoscaling & batch. Adds namespace-level resource breakdowns, node allocation pressure, and per-workload-type rollout drill-downs that v1 lacked. Perses-compatible.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true,
      "title": "Runbook: kube-state-metrics",
      "tooltip": "Runbook in rtifact-alert-rules",
      "type": "link",
      "url": "https://github.com/cipherops-io/rtifact-alert-rules/blob/main/runbooks/kubernetes/kube-state-metrics.yaml"
    },
    {
      "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true,
      "title": "Runbook: kubernetes workloads",
      "tooltip": "Workload alert runbook",
      "type": "link",
      "url": "https://github.com/cipherops-io/rtifact-alert-rules/blob/main/runbooks/kubernetes/workloads.yaml"
    }
  ],
  "liveNow": false,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": [], "title": "Cluster snapshot", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of nodes currently reporting Ready=true.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 3}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 0, "y": 1}, "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(kube_node_status_condition{cluster=~\"$cluster\",condition=\"Ready\",status=\"true\"} == 1) OR vector(0)", "instant": true, "legendFormat": "Ready", "refId": "A"}],
      "title": "Nodes Ready", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Total namespaces in the cluster.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 3, "y": 1}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(kube_namespace_created{cluster=~\"$cluster\"}) OR vector(0)", "instant": true, "legendFormat": "Namespaces", "refId": "A"}],
      "title": "Namespaces", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Pods currently in Running phase.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 6, "y": 1}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(kube_pod_status_phase{cluster=~\"$cluster\",namespace=~\"$namespace\",phase=\"Running\"}) OR vector(0)", "instant": true, "legendFormat": "Running", "refId": "A"}],
      "title": "Pods Running", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Containers currently stuck in CrashLoopBackOff.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 9, "y": 1}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(kube_pod_container_status_waiting_reason{cluster=~\"$cluster\",namespace=~\"$namespace\",reason=\"CrashLoopBackOff\"}) OR vector(0)", "instant": true, "legendFormat": "CrashLoop", "refId": "A"}],
      "title": "CrashLoopBackOff", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Containers OOMKilled within the last hour.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 12, "y": 1}, "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(max by (namespace, pod, container) (max_over_time(kube_pod_container_status_last_terminated_reason{cluster=~\"$cluster\",namespace=~\"$namespace\",reason=\"OOMKilled\"}[1h])) == 1) OR vector(0)", "instant": true, "legendFormat": "OOM", "refId": "A"}],
      "title": "OOMKilled (1h)", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Sum of degraded deployments + statefulsets + daemonsets (any with fewer ready/available replicas than desired).",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 15, "y": 1}, "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "(count(kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_deployment_status_replicas_available{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0) OR vector(0)) + (count(kube_statefulset_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_statefulset_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0) OR vector(0)) + (count(kube_daemonset_status_desired_number_scheduled{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_daemonset_status_number_ready{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0) OR vector(0))", "instant": true, "legendFormat": "Degraded", "refId": "A"}],
      "title": "Workloads degraded", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "PVCs in Pending or Lost phase.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 18, "y": 1}, "id": 7,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(kube_persistentvolumeclaim_status_phase{cluster=~\"$cluster\",namespace=~\"$namespace\",phase=~\"Pending|Lost\"} == 1) OR vector(0)", "instant": true, "legendFormat": "PVC issues", "refId": "A"}],
      "title": "PVCs Pending / Lost", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "HPAs that have hit their max replica limit (cannot scale further).",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 3, "x": 21, "y": 1}, "id": 8,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(kube_horizontalpodautoscaler_status_current_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\"} >= kube_horizontalpodautoscaler_spec_max_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\"}) OR vector(0)", "instant": true, "legendFormat": "At max", "refId": "A"}],
      "title": "HPAs at max", "type": "stat"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": [], "title": "Workload health", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Pods grouped by phase over time.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6}, "id": 9,
      "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (phase) (kube_pod_status_phase{cluster=~\"$cluster\",namespace=~\"$namespace\"})", "legendFormat": "{{phase}}", "refId": "A"}],
      "title": "Pods by phase", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Containers stuck in waiting, by reason. Excludes ContainerCreating which is normal.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "none"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6}, "id": 10,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (reason) (kube_pod_container_status_waiting_reason{cluster=~\"$cluster\",namespace=~\"$namespace\",reason!=\"ContainerCreating\"})", "legendFormat": "{{reason}}", "refId": "A"}],
      "title": "Containers waiting by reason", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 namespaces by total pod count.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "id": 11,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, count by (namespace) (kube_pod_info{cluster=~\"$cluster\",namespace=~\"$namespace\"}))", "legendFormat": "{{namespace}}", "refId": "A"}],
      "title": "Top 10 namespaces by pod count", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 namespaces by total container restart count over the last hour.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "id": 12,
      "options": {"legend": {"calcs": ["max", "sum"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, sum by (namespace) (increase(kube_pod_container_status_restarts_total{cluster=~\"$cluster\",namespace=~\"$namespace\"}[1h])))", "legendFormat": "{{namespace}}", "refId": "A"}],
      "title": "Top 10 namespaces by restarts (1h)", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "id": 102, "panels": [], "title": "Workload rollout", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 deployments by missing-replica count.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 2, "showPoints": "auto", "spanNulls": false}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 23}, "id": 13,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, kube_deployment_spec_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_deployment_status_replicas_available{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0)", "legendFormat": "{{namespace}}/{{deployment}}", "refId": "A"}],
      "title": "Top 10 deployments missing replicas", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 statefulsets and daemonsets by missing-pod count.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 2, "showPoints": "auto", "spanNulls": false}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 23}, "id": 14,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, kube_statefulset_replicas{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_statefulset_status_replicas_ready{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0)", "legendFormat": "sts {{namespace}}/{{statefulset}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, kube_daemonset_status_desired_number_scheduled{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_daemonset_status_number_ready{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0)", "legendFormat": "ds {{namespace}}/{{daemonset}}", "refId": "B"}
      ],
      "title": "Top 10 statefulsets / daemonsets missing pods", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of deployments + statefulsets where the controller has not yet observed the latest spec generation. Indicates an in-flight or stuck rollout.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 23}, "id": 15,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(count(kube_deployment_metadata_generation{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_deployment_status_observed_generation{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0) OR vector(0), \"kind\", \"deployment\", \"\", \"\")", "legendFormat": "{{kind}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(count(kube_statefulset_metadata_generation{cluster=~\"$cluster\",namespace=~\"$namespace\"} - kube_statefulset_status_observed_generation{cluster=~\"$cluster\",namespace=~\"$namespace\"} > 0) OR vector(0), \"kind\", \"statefulset\", \"\", \"\")", "legendFormat": "{{kind}}", "refId": "B"}
      ],
      "title": "Generation-drift count (deploy + sts)", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31}, "id": 103, "panels": [], "title": "Node status", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of nodes reporting each pressure condition. Lines should ride zero.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 20, "gradientMode": "opacity", "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never", "spanNulls": false, "stacking": {"group": "A", "mode": "none"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 32}, "id": 16,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (condition) (kube_node_status_condition{cluster=~\"$cluster\",node=~\"$node\",condition=~\"MemoryPressure|DiskPressure|PIDPressure|NetworkUnavailable\",status=\"true\"} == 1)", "legendFormat": "{{condition}}", "refId": "A"}],
      "title": "Active node pressure conditions", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Schedulable vs unschedulable (cordoned) nodes over time.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 32}, "id": 17,
      "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(count(kube_node_spec_unschedulable{cluster=~\"$cluster\",node=~\"$node\"} == 0) OR vector(0), \"state\", \"schedulable\", \"\", \"\")", "legendFormat": "{{state}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(count(kube_node_spec_unschedulable{cluster=~\"$cluster\",node=~\"$node\"} == 1) OR vector(0), \"state\", \"unschedulable\", \"\", \"\")", "legendFormat": "{{state}}", "refId": "B"}
      ],
      "title": "Schedulable vs unschedulable nodes", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 nodes by pod count. Allocation-pressure indicator — nodes near max-pods are at risk.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 100}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 32}, "id": 18,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, count by (node) (kube_pod_info{cluster=~\"$cluster\",node=~\"$node\"}))", "legendFormat": "{{node}}", "refId": "A"}],
      "title": "Top 10 nodes by pod count", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 40}, "id": 104, "panels": [], "title": "Storage", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "PVCs grouped by phase over time.",
