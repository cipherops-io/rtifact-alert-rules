{
  "annotations": {"list": []},
  "description": "Essential host-level dashboard from node-exporter. 15 high-signal panels for on-call. Perses-compatible (stat + timeseries only).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Runbook: node-exporter",
      "tooltip": "Runbook in rtifact-alert-rules",
      "type": "link",
      "url": "https://github.com/cipherops-io/rtifact-alert-rules/blob/main/runbooks/kubernetes/node-exporter.yaml"
    }
  ],
  "liveNow": false,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": [], "title": "Cluster snapshot", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Active nodes reporting node-exporter metrics.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 3}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1}, "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "count(node_uname_info{cluster=~\"$cluster\",instance=~\"$instance\"})",
        "instant": true, "legendFormat": "Active nodes", "refId": "A"
      }],
      "title": "Active nodes", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Sum of CPU cores across all nodes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(count without (cpu, mode) (node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}))",
        "instant": true, "legendFormat": "CPU cores", "refId": "A"
      }],
      "title": "Total CPU cores", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Sum of physical memory across all nodes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "bytes"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "sum(node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"})",
        "instant": true, "legendFormat": "Total memory", "refId": "A"
      }],
      "title": "Total memory", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Cluster-wide CPU utilisation (non-idle).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "max": 1, "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]},
          "unit": "percentunit"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "1 - avg(rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}[5m]))",
        "instant": true, "legendFormat": "CPU used %", "refId": "A"
      }],
      "title": "Cluster CPU utilisation", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of nodes with CPU utilisation above 85%.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 5}, "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "count((1 - avg by (instance) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}[5m]))) > 0.85) OR vector(0)",
        "instant": true, "legendFormat": "High CPU", "refId": "A"
      }],
      "title": "Nodes CPU > 85%", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of nodes with memory utilisation above 90%.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 5}, "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "count((1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"}) > 0.9) OR vector(0)",
        "instant": true, "legendFormat": "High memory", "refId": "A"
      }],
      "title": "Nodes memory > 90%", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of filesystems with usage above 85% (excludes tmpfs / overlay / squashfs).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 5}, "id": 7,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "count((1 - node_filesystem_avail_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|fuse.lxcfs|squashfs|overlay|nsfs\"} / node_filesystem_size_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|fuse.lxcfs|squashfs|overlay|nsfs\"}) > 0.85) OR vector(0)",
        "instant": true, "legendFormat": "Filesystems > 85%", "refId": "A"
      }],
      "title": "Filesystems > 85% full", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Nodes whose 5-minute load average exceeds 2x the number of CPU cores. Indicates sustained CPU contention.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 5}, "id": 8,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "count((node_load5{cluster=~\"$cluster\",instance=~\"$instance\"} / count without (cpu, mode) (node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"})) > 2) OR vector(0)",
        "instant": true, "legendFormat": "High load", "refId": "A"
      }],
      "title": "Nodes load > 2x cores", "type": "stat"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}, "id": 101, "panels": [], "title": "Resource trends", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 nodes by CPU utilisation (5-minute average, non-idle).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true},
          "mappings": [],
          "max": 1, "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.85}]},
          "unit": "percentunit"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10}, "id": 9,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, 1 - avg by (instance) (rate(node_cpu_seconds_total{cluster=~\"$cluster\",instance=~\"$instance\",mode=\"idle\"}[5m])))",
        "legendFormat": "{{instance}}", "refId": "A"
      }],
      "title": "Top 10 nodes by CPU %", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 nodes by memory utilisation.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true},
          "mappings": [],
          "max": 1, "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]},
          "unit": "percentunit"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10}, "id": 10,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, 1 - node_memory_MemAvailable_bytes{cluster=~\"$cluster\",instance=~\"$instance\"} / node_memory_MemTotal_bytes{cluster=~\"$cluster\",instance=~\"$instance\"})",
        "legendFormat": "{{instance}}", "refId": "A"
      }],
      "title": "Top 10 nodes by memory %", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 nodes by total network throughput (rx + tx).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "Bps"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 18}, "id": 11,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, sum by (instance) (rate(node_network_receive_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\",device!~\"lo|veth.*|cni.*|flannel.*|cali.*|docker.*\"}[5m])) + sum by (instance) (rate(node_network_transmit_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\",device!~\"lo|veth.*|cni.*|flannel.*|cali.*|docker.*\"}[5m])))",
        "legendFormat": "{{instance}}", "refId": "A"
      }],
      "title": "Top 10 nodes by network throughput (rx+tx)", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 nodes by total disk I/O (reads + writes).",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]},
          "unit": "Bps"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 18}, "id": 12,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, sum by (instance) (rate(node_disk_read_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])) + sum by (instance) (rate(node_disk_written_bytes_total{cluster=~\"$cluster\",instance=~\"$instance\"}[5m])))",
        "legendFormat": "{{instance}}", "refId": "A"
      }],
      "title": "Top 10 nodes by disk I/O", "type": "timeseries"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}, "id": 102, "panels": [], "title": "Top offenders", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 filesystems by % usage. Lines climbing toward 100% require capacity expansion.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 2, "showPoints": "auto", "spanNulls": true},
          "mappings": [],
          "max": 1, "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]},
          "unit": "percentunit"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 27}, "id": 13,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, 1 - node_filesystem_avail_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|fuse.lxcfs|squashfs|overlay|nsfs\"} / node_filesystem_size_bytes{cluster=~\"$cluster\",instance=~\"$instance\",fstype!~\"tmpfs|fuse.lxcfs|squashfs|overlay|nsfs\"})",
        "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A"
      }],
      "title": "Top 10 filesystems by % used", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "5-minute load average for the top 10 noisiest nodes.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 10}]},
          "unit": "none"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 27}, "id": 14,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, node_load5{cluster=~\"$cluster\",instance=~\"$instance\"})",
        "legendFormat": "{{instance}}", "refId": "A"
      }],
      "title": "Top 10 nodes by 5m load average", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 nodes by file descriptor usage (% of OS limit). Sustained > 80% means a leak.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "linear", "lineWidth": 2, "showPoints": "auto", "spanNulls": true},
          "mappings": [],
          "max": 1, "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.8}, {"color": "red", "value": 0.9}]},
          "unit": "percentunit"
        }, "overrides": []
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 35}, "id": 15,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "expr": "topk(10, node_filefd_allocated{cluster=~\"$cluster\",instance=~\"$instance\"} / node_filefd_maximum{cluster=~\"$cluster\",instance=~\"$instance\"})",
        "legendFormat": "{{instance}}", "refId": "A"
      }],
      "title": "Top 10 nodes by file descriptor usage", "type": "timeseries"
    }
  ],
  "refresh": "30s", "revision": 1, "schemaVersion": 39,
  "tags": ["kubernetes", "node-exporter", "rtifact", "essentials", "perses-compatible"],
  "templating": {
