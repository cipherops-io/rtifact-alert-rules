{
  "annotations": {"list": []},
  "description": "Production CloudNativePG dashboard. Cluster topology, replication, WAL, backups, connections, performance. Perses-compatible (stat + timeseries only).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false, "icon": "external link", "includeVars": false, "keepTime": false, "tags": [], "targetBlank": true,
      "title": "Runbook: cnpg",
      "tooltip": "Runbook in rtifact-alert-rules",
      "type": "link",
      "url": "https://github.com/cipherops-io/rtifact-alert-rules/blob/main/runbooks/databases/cnpg.md"
    }
  ],
  "liveNow": false,
  "panels": [
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "id": 100, "panels": [], "title": "Cluster snapshot", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of PostgreSQL primary instances (in_recovery == 0).",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1}, "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(cnpg_pg_replication_in_recovery{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"} == 0) OR vector(0)", "instant": true, "legendFormat": "Primaries", "refId": "A"}],
      "title": "Primary instances", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of replica instances with a healthy WAL receiver streaming from the primary.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}, {"color": "green", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "count(cnpg_pg_replication_is_wal_receiver_up{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"} == 1) OR vector(0)", "instant": true, "legendFormat": "Replicas", "refId": "A"}],
      "title": "Streaming replicas", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Total active database backends across all CNPG clusters in scope.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum(cnpg_backends_total{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}) OR vector(0)", "instant": true, "legendFormat": "Backends", "refId": "A"}],
      "title": "Active backends", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Worst current replication lag across all replicas. Sustained > 30s = RPO at risk.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 120}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1}, "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max(cnpg_pg_replication_lag{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}) OR vector(0)", "instant": true, "legendFormat": "Max lag", "refId": "A"}],
      "title": "Worst replication lag", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Hours since the most recent successful backup. Should refresh per backup schedule.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 24}, {"color": "red", "value": 48}]}, "unit": "h"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1}, "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "(time() - max(cnpg_collector_last_available_backup_timestamp{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"})) / 3600", "instant": true, "legendFormat": "Hours", "refId": "A"}],
      "title": "Hours since last backup", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Longest currently-running non-idle transaction across all clusters.",
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 300}, {"color": "red", "value": 1800}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1}, "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "pluginVersion": "10.4.0",
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max(cnpg_backends_max_tx_duration_seconds{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\",state!=\"idle\"}) OR vector(0)", "instant": true, "legendFormat": "Max tx", "refId": "A"}],
      "title": "Longest non-idle tx", "type": "stat"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 101, "panels": [], "title": "Cluster topology", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Primary vs replica pod count per CNPG cluster over time.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 30, "gradientMode": "opacity", "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never", "spanNulls": true, "stacking": {"group": "A", "mode": "normal"}}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 6}, "id": 7,
      "options": {"legend": {"calcs": ["mean", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(count by (cnpg_cluster) (cnpg_pg_replication_in_recovery{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"} == 0), \"role\", \"primary\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{role}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(count by (cnpg_cluster) (cnpg_pg_replication_in_recovery{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"} == 1), \"role\", \"replica\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{role}}", "refId": "B"}
      ],
      "title": "Primary vs replica count by cluster", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "WAL receiver state on each replica pod. 1 = healthy, 0 = down.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never", "spanNulls": false}, "mappings": [], "max": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 6}, "id": 8,
      "options": {"legend": {"calcs": ["min", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "cnpg_pg_replication_is_wal_receiver_up{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}", "legendFormat": "{{cnpg_cluster}}/{{pod}}", "refId": "A"}],
      "title": "WAL receiver status by pod", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of streaming replicas seen by the primary, by cluster.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "stepAfter", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 6}, "id": 9,
      "options": {"legend": {"calcs": ["min", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max by (cnpg_cluster) (cnpg_pg_replication_streaming_replicas{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"})", "legendFormat": "{{cnpg_cluster}}", "refId": "A"}],
      "title": "Streaming replicas by cluster", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14}, "id": 102, "panels": [], "title": "Replication", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Replication lag in seconds by cluster (replica side). The age of the last replayed WAL record on each replica.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 30}, {"color": "red", "value": 120}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 15}, "id": 10,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max by (cnpg_cluster, pod) (cnpg_pg_replication_lag{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"})", "legendFormat": "{{cnpg_cluster}}/{{pod}}", "refId": "A"}],
      "title": "Replication lag (seconds)", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Replication lag in bytes (LSN diff). Captures lag the replica hasn't replayed yet, even if writes are quiet.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 100000000}, {"color": "red", "value": 1073741824}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 15}, "id": 11,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max by (cnpg_cluster, application_name) (cnpg_pg_stat_replication_replay_diff_bytes{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"})", "legendFormat": "{{cnpg_cluster}}/{{application_name}}", "refId": "A"}],
      "title": "Replication LSN diff (replay)", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Replication stage breakdown (write / flush / replay) lag in seconds, per cluster. Helps locate the bottleneck.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 15}, "id": 12,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(max by (cnpg_cluster) (cnpg_pg_stat_replication_write_lag_seconds{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}), \"stage\", \"write\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{stage}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(max by (cnpg_cluster) (cnpg_pg_stat_replication_flush_lag_seconds{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}), \"stage\", \"flush\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{stage}}", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(max by (cnpg_cluster) (cnpg_pg_stat_replication_replay_lag_seconds{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}), \"stage\", \"replay\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{stage}}", "refId": "C"}
      ],
      "title": "Replication lag stages (write / flush / replay)", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23}, "id": 103, "panels": [], "title": "Connections & transactions", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Active vs waiting backends per cluster. Waiting backends are blocked on locks.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24}, "id": 13,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum by (cnpg_cluster) (cnpg_backends_total{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}), \"kind\", \"active\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{kind}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum by (cnpg_cluster) (cnpg_backends_waiting_total{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}), \"kind\", \"waiting\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{kind}}", "refId": "B"}
      ],
      "title": "Active vs waiting backends by cluster", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Longest non-idle transaction duration per cluster. Long-running transactions block autovacuum and hold locks.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 300}, {"color": "red", "value": 1800}]}, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24}, "id": 14,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max by (cnpg_cluster, state) (cnpg_backends_max_tx_duration_seconds{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\",state!=\"idle\"})", "legendFormat": "{{cnpg_cluster}} {{state}}", "refId": "A"}],
      "title": "Longest non-idle transaction by cluster", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Commits vs rollbacks rate per cluster. High rollback rate indicates application errors or deadlocks.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24}, "id": 15,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum by (cnpg_cluster) (rate(cnpg_pg_stat_database_xact_commit{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}[5m])), \"kind\", \"commit\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{kind}}", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "label_replace(sum by (cnpg_cluster) (rate(cnpg_pg_stat_database_xact_rollback{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}[5m])), \"kind\", \"rollback\", \"\", \"\")", "legendFormat": "{{cnpg_cluster}} {{kind}}", "refId": "B"}
      ],
      "title": "Commits vs rollbacks rate", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 32}, "id": 104, "panels": [], "title": "Storage & WAL", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Top 10 databases by size on disk.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 33}, "id": 16,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "topk(10, max by (cnpg_cluster, datname) (cnpg_pg_database_size_bytes{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}))", "legendFormat": "{{cnpg_cluster}}/{{datname}}", "refId": "A"}],
      "title": "Top 10 databases by size", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "WAL bytes generated per cluster. Spikes correlate with heavy write load.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 33}, "id": 17,
      "options": {"legend": {"calcs": ["max", "mean"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "sum by (cnpg_cluster) (rate(cnpg_collector_wal_bytes{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"}[5m]))", "legendFormat": "{{cnpg_cluster}}", "refId": "A"}],
      "title": "WAL generation rate by cluster", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Number of WAL files currently in pg_wal per cluster. Sustained growth = inactive replication slot or archive failure.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "lineInterpolation": "smooth", "lineWidth": 2, "showPoints": "never", "spanNulls": true}, "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1000}]}, "unit": "none"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 33}, "id": 18,
      "options": {"legend": {"calcs": ["max", "lastNotNull"], "displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"datasource": {"type": "prometheus", "uid": "${datasource}"}, "expr": "max by (cnpg_cluster) (cnpg_collector_pg_wal{cluster=~\"$cluster\",cnpg_cluster=~\"$cnpg_cluster\"})", "legendFormat": "{{cnpg_cluster}}", "refId": "A"}],
      "title": "WAL file count by cluster", "type": "timeseries"
    },

    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 41}, "id": 105, "panels": [], "title": "Backups & WAL archiving", "type": "row"},

    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Hours since the last successful backup per cluster.",
